{
  "name": "quick-bookmark",
  "version": "4.0.0",
  "description": "Quickly bookmark the current page into a chosen folder via fuzzy search",
  "author": "Your Name",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:ui",
    "build": "npm run typecheck && vite build",
    "watch": "vite build --watch --mode development",
    "package:zip": "node scripts/package-release.mjs",
    "store:images": "node --import tsx scripts/capture-store-images.mts",
    "package:kit": "node scripts/package-publishing-kit.mjs",
    "build:release": "npm run build && npm run package:zip"
  },
  "dependencies": {
    "fuse.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.19.1",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^4.0.0"
  }
}
